# --- Segurança: NUNCA versionar ---
*.jks
*.keystore
keystore.properties
local.properties

# --- Dependências ---
node_modules/

# --- Build Angular/Ionic ---
APK/www/
APK/.angular/
APK/dist/
APK/coverage/

# --- Build Android ---
APK/android/.gradle/
APK/android/build/
APK/android/app/build/
APK/android/app/src/main/assets/public/
APK/android/app/src/main/res/raw/
APK/android/capacitor-cordova-android-plugins/
*.apk
*.aab

# --- Artefatos de publicação ---
DEPLOY/*.aab

# --- Assets derivados (gerados por npm run assets / npm run icons) ---
APK/src/assets/images/
APK/src/assets/sounds/

# --- Assets originais: obra comercial, fora do repositorio publico ---
# Sao a FONTE de tudo que o pipeline gera (ver DOC/ESPECIFICATION.md secao 3).
# Ficam apenas na maquina do desenvolvedor e em backup proprio; sem eles
# `npm run assets` e `npm run icons` nao tem o que converter.
PROJECT/assets/
PROJECT/sounds/

