<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Verde da marca em vez de @null: sem isso a janela aparece BRANCA
             entre o fim da splash e o primeiro frame do WebView. -->
        <item name="android:background">@color/brandColor</item>
    </style>

    <!--
        Splash (BACKLOG 0.5). A partir da API 31 o Android usa
        Theme.SplashScreen, que ignora `android:background` e monta a tela com
        `windowSplashScreenBackground` + `windowSplashScreenAnimatedIcon`.
        Declarar so o drawable — como estava — resultava em fundo branco com o
        icone padrao do sistema em aparelhos novos, que foi o defeito relatado
        no teste real. Os itens antigos ficam para aparelhos abaixo da API 31.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brandColor</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
